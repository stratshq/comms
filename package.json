{
  "name": "comms",
  "version": "0.1.0",
  "private": true,
  "description": "Comms — an open-source, self-hostable team inbox + ticketing platform for iMessage (via BlueBubbles) and beyond.",
  "keywords": [
    "imessage",
    "bluebubbles",
    "shared-inbox",
    "helpdesk",
    "ticketing",
    "customer-support",
    "self-hosted",
    "railway",
    "nextjs",
    "ai"
  ],
  "homepage": "https://github.com/byw1/comms#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/byw1/comms.git"
  },
  "bugs": {
    "url": "https://github.com/byw1/comms/issues"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @comms/db build && pnpm --filter @comms/core build && pnpm --filter @comms/enterprise build && pnpm --filter @comms/ai build && pnpm --filter @comms/worker build && pnpm --filter @comms/web build",
    "build:www": "pnpm --filter @comms/www build",
    "dev": "pnpm --parallel --filter @comms/web --filter @comms/worker dev",
    "dev:web": "pnpm --filter @comms/web dev",
    "dev:worker": "pnpm --filter @comms/worker dev",
    "dev:www": "pnpm --filter @comms/www dev",
    "start:web": "pnpm --filter @comms/web start",
    "start:worker": "pnpm --filter @comms/worker start",
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @comms/db generate",
    "db:migrate": "pnpm --filter @comms/db migrate",
    "db:push": "pnpm --filter @comms/db push",
    "db:studio": "pnpm --filter @comms/db studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.11.1"
    }
  }
}
